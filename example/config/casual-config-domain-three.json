{
    "domain": {
        "name": "quarkus-casual-domain-three"
    },
    "unmanaged": true,
    "outbound":{
        "unmanaged": true,
        "useEpoll": true
    },
    "inbound": {
        "useEpoll": true,
        "startup": {
            "mode": "discover",
            "services": [
                "echo",
                "nonTransactionalEcho",
                "reverse",
                "echoFielded",
                "sum"
            ]
        }       
    },
    "eventServer":{
        "portNumber": 9899,
        "useEpoll": true
    }
}
